# Copy to .env and fill in. docker compose reads this file automatically.

# Signs login and drone tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Shared secret between the backend and the AI service (any long random string)
AI_SERVICE_TOKEN=

# First admin account, created only when the database has no users (min 12 chars)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port the web app is published on, and the URL people open it at
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080

# COCO classes that raise alerts when detected
ALERT_CLASSES=person,car,truck,bus,motorcycle,airplane,boat
